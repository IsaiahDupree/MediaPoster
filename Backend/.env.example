DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase URLs (Local Development)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_STUDIO_URL=http://127.0.0.1:54323
SUPABASE_INBUCKET_URL=http://127.0.0.1:54324
SUPABASE_DB_PORT=54322

# Supabase Keys
SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_JWT_SECRET=your-jwt-secret-here

# API Keys
OPENAI_API_KEY=your-openai-key
BLOTATO_API_KEY=your-blotato-key

# RapidAPI (for social media data fetching)
RAPIDAPI_KEY=your-rapidapi-key-here

# Social Media Accounts (comma-separated for multiple accounts per platform)
# YouTube
YOUTUBE_CHANNEL_IDS=UCxxxxx,UCyyyyy
YOUTUBE_API_KEY=your-youtube-api-key-here

# Instagram
INSTAGRAM_USERNAMES=username1,username2

# TikTok
TIKTOK_USERNAMES=username1,username2

# Twitter/X
TWITTER_USERNAMES=username1,username2

# LinkedIn (full profile URLs)
LINKEDIN_PROFILE_URLS=https://linkedin.com/in/user1,https://linkedin.com/in/user2

# Threads
THREADS_USERNAMES=username1

# Pinterest
PINTEREST_USERNAMES=username1

# Medium
MEDIUM_USERNAMES=username1

# =============================================================================
# MEDIAPOSTER LITE (MPLite) — Cloud Publishing Queue
# =============================================================================
# MPLite is the preferred organic publishing backend for ACTP.
# When MPLITE_KEY is set, ACTP enqueues videos in the cloud queue and
# the local machine polls + executes Safari automation / Blotato uploads.
#
# Dashboard: https://mediaposter-lite-isaiahduprees-projects.vercel.app
# API:       https://mediaposter-lite-isaiahduprees-projects.vercel.app/api
# CLI:       node /path/to/mediaposter-lite/cli/mplite.js
#
# To get your API key: open the dashboard → Settings → API Keys → Create

MPLITE_URL=https://mediaposter-lite-isaiahduprees-projects.vercel.app
MPLITE_KEY=mpl_your_key_here

# Default account ID used when platform-specific account is not set
MPLITE_DEFAULT_ACCOUNT_ID=your_default_account_id

# Per-platform account IDs (used when ACTP enqueues via MPLite)
TIKTOK_ACCOUNT_ID=your_tiktok_account_id
YOUTUBE_ACCOUNT_ID=your_youtube_account_id
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
TWITTER_ACCOUNT_ID=your_twitter_account_id
THREADS_ACCOUNT_ID=your_threads_account_id

# =============================================================================
# ACTP — Ad Creative Testing Pipeline
# =============================================================================
# Landing page base URL for tracking URLs generated by LandingPageManager
ACTP_LANDING_BASE_URL=https://app.waitlistlab.com/lp

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=5555
BACKEND_URL=http://localhost:5555
FRONTEND_URL=http://localhost:5557
DASHBOARD_URL=http://localhost:5557
