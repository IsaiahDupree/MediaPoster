{
    "name": "Rapid API Youtube Insight To Medium Notes V10 (Content Created)",
    "description": "YouTube Playlist → Transcript → AI Analysis → Multi-platform publish",
    "version": "10",
    "created": "2026-01-20",
    "trigger": {
        "type": "google_sheets_filter",
        "config": {
            "spreadsheet_id": "1HhB3A4BgJZRlQsRfwZZp8Krke7YT--Hsy0ybcnfZ7HQ",
            "spreadsheet_name": "Youtube Wisdom copy",
            "sheet_name": "Main",
            "filter_column": "S",
            "filter_value": "ID_Captured",
            "sort_order": "desc",
            "limit": 1
        }
    },
    "steps": [
        {
            "id": 1,
            "name": "Filter Google Sheet Rows",
            "module": "google-sheets:filterRows",
            "description": "Get videos with status 'ID_Captured'",
            "outputs": [
                "Playlist ID (A)",
                "Video ID (B)",
                "Title (C)",
                "Description (D)",
                "Transcription (E)",
                "Overview (F)",
                "Insights (G)",
                "Owner (H)",
                "Owner ID (I)",
                "Publish Time (J)",
                "Image File ID (K)",
                "SEO Title (L)",
                "Medium image url (M)",
                "Medium Blog Post HTML (O)",
                "Medium Blog URL (Q)",
                "Status (S)",
                "Content 1-7 (T-Z)"
            ]
        },
        {
            "id": 2,
            "name": "Fetch YouTube Transcript",
            "module": "http:ActionSendData",
            "description": "Get video transcript from RapidAPI",
            "config": {
                "url": "https://youtube-transcriptor.p.rapidapi.com/transcript",
                "method": "GET",
                "params": {
                    "video_id": "{{step1.video_id}}",
                    "lang": "en"
                },
                "headers": {
                    "x-rapidapi-host": "youtube-transcriptor.p.rapidapi.com",
                    "x-rapidapi-key": "{{RAPIDAPI_KEY}}"
                }
            }
        },
        {
            "id": 3,
            "name": "Parse JSON Response",
            "module": "json:ParseJSON",
            "description": "Extract transcript data"
        },
        {
            "id": 4,
            "name": "Router",
            "module": "builtin:BasicRouter",
            "description": "Branch based on transcript fetch success",
            "routes": [
                {
                    "condition": "statusCode == 200",
                    "name": "Success Route",
                    "steps": ["GPT Processing", "Content Distribution"]
                },
                {
                    "condition": "statusCode != 200",
                    "name": "Error Route",
                    "steps": ["Log Error", "Update Status"]
                }
            ]
        },
        {
            "id": 5,
            "name": "GPT-4o Transcript Decode",
            "module": "openai-gpt-3:CreateCompletion",
            "description": "Decode JSON transcript to readable text",
            "config": {
                "model": "gpt-4o",
                "max_tokens": 3500,
                "temperature": 1,
                "prompt": "Decode this JSON Data from a Youtube Video into a transcript."
            }
        },
        {
            "id": 6,
            "name": "GPT-4o Generate Overview",
            "module": "openai-gpt-3:CreateCompletion",
            "description": "Generate content overview"
        },
        {
            "id": 7,
            "name": "GPT-4o Generate Insights",
            "module": "openai-gpt-3:CreateCompletion",
            "description": "Extract key insights"
        },
        {
            "id": 8,
            "name": "GPT-4o Generate SEO Title",
            "module": "openai-gpt-3:CreateCompletion",
            "description": "Create SEO-optimized title"
        },
        {
            "id": 9,
            "name": "GPT-4o Generate Medium Blog HTML",
            "module": "openai-gpt-3:CreateCompletion",
            "description": "Format as Medium blog post"
        },
        {
            "id": 10,
            "name": "Upload Thumbnail to Google Drive",
            "module": "google-drive:uploadFile",
            "description": "Store video thumbnail"
        },
        {
            "id": 11,
            "name": "Create Medium Post",
            "module": "medium:createPost",
            "description": "Publish blog to Medium"
        },
        {
            "id": 12,
            "name": "Post to Bluesky via Blotato",
            "module": "http:ActionSendData",
            "config": {
                "url": "https://backend.blotato.com/v2/posts",
                "method": "POST",
                "headers": {
                    "blotato-api-key": "{{BLOTATO_API_KEY}}"
                },
                "body": {
                    "post": {
                        "target": {"targetType": "bluesky"},
                        "content": {
                            "text": "{{social_snippet}}",
                            "platform": "bluesky",
                            "mediaUrls": []
                        },
                        "accountId": "2"
                    }
                }
            }
        },
        {
            "id": 13,
            "name": "Post to Threads via Blotato",
            "module": "http:ActionSendData",
            "config": {
                "url": "https://backend.blotato.com/v2/posts",
                "method": "POST"
            }
        },
        {
            "id": 14,
            "name": "Post to Buffer",
            "module": "buffer:ActionCreateStatus",
            "config": {
                "profiles": ["67748baf4697c1deffa43aee"],
                "shorten_links": true,
                "type": "now"
            }
        },
        {
            "id": 15,
            "name": "Update Google Sheet Status",
            "module": "google-sheets:updateRow",
            "description": "Mark as Published with URLs"
        }
    ],
    "connections": {
        "google": {
            "label": "My Google connection (isaiahdupree33@gmail.com)",
            "scoped": true
        },
        "openai": {
            "label": "OpenAI API"
        },
        "buffer": {
            "label": "My Buffer connection (Isaiah Dupree)"
        },
        "blotato": {
            "api_key_env": "BLOTATO_API_KEY"
        },
        "rapidapi": {
            "api_key_env": "RAPIDAPI_KEY"
        }
    },
    "environment_variables": [
        "RAPIDAPI_KEY",
        "BLOTATO_API_KEY",
        "OPENAI_API_KEY"
    ],
    "zone": "us1.make.com",
    "notes": [
        "This scenario processes YouTube videos saved to a playlist",
        "Videos are logged to Google Sheet with status 'ID_Captured'",
        "Transcripts fetched via RapidAPI youtube-transcriptor",
        "GPT-4o generates overview, insights, SEO title, and blog content",
        "Content distributed to Medium, Bluesky, Threads, and Buffer"
    ]
}
