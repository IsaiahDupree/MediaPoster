"""
Master Orchestrator Service (ARCH-001)
=======================================
Coordinates all subsystems into unified pipelines.

Workflow:
    Sora (1-3 part) → Stitch → Analyze → Auto-fill → Post to 22 Blotato accounts
                                                          ↓
    Tweet every 2h → Track Engagement → Optimize → Drive Offer Traffic

Features:
- ARCH-001: Master orchestrator coordinating all subsystems
- ARCH-002: 3-part Sora batch coordination
- ARCH-003: Content analyzer → Publisher integration
- ARCH-004: Tweet scheduler 2-hour interval
- ARCH-005: Offer traffic tracking integration
- ARCH-006: Analytics → AI feedback loop integration
"""

import asyncio
import logging
import os
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, Any, List, Optional
from uuid import uuid4

from dotenv import load_dotenv
from sqlalchemy import create_engine
from services.event_bus import EventBus, Event, Topics
from services.content_analyzer import ContentAnalyzer

load_dotenv()

logger = logging.getLogger(__name__)

# Database connection
DATABASE_URL = os.getenv("DATABASE_URL", "postgresql://postgres:postgres@127.0.0.1:54322/postgres")


class PipelineConfig:
    """Configuration for a pipeline execution."""

    def __init__(
        self,
        theme: str,
        num_parts: int = 3,
        character: Optional[str] = None,
        publish_platforms: Optional[List[str]] = None,
        schedule_tweets: bool = True,
        tweets_per_day: int = 12,
        offer_url: Optional[str] = None,
        metadata: Optional[Dict[str, Any]] = None
    ):
        self.theme = theme
        self.num_parts = num_parts
        self.character = character
        self.publish_platforms = publish_platforms or ["tiktok", "instagram", "youtube"]
        self.schedule_tweets = schedule_tweets
        self.tweets_per_day = tweets_per_day
        self.offer_url = offer_url
        self.metadata = metadata or {}


class PipelineStep:
    """Represents a single step in the pipeline."""

    def __init__(self, name: str, order: int):
        self.name = name
        self.order = order
        self.status = "pending"
        self.started_at: Optional[datetime] = None
        self.completed_at: Optional[datetime] = None
        self.error: Optional[str] = None
        self.output: Dict[str, Any] = {}


class MasterOrchestrator:
    """Master Orchestrator Service (ARCH-001)"""

    _instance: Optional['MasterOrchestrator'] = None

    def __init__(self, event_bus: Optional[EventBus] = None):
        self.event_bus = event_bus or EventBus.get_instance()
        self.engine = create_engine(DATABASE_URL)
        self.content_analyzer = ContentAnalyzer()
        self.active_pipelines: Dict[str, Dict[str, Any]] = {}
        self._setup_subscriptions()
        logger.info("🎯 Master Orchestrator initialized")

    @classmethod
    def get_instance(cls, event_bus: Optional[EventBus] = None) -> 'MasterOrchestrator':
        if cls._instance is None:
            cls._instance = cls(event_bus)
        return cls._instance

    def _setup_subscriptions(self) -> None:
        self.event_bus.subscribe(Topics.SORA_BATCH_COMPLETED, self._handle_sora_batch_completed)
        self.event_bus.subscribe(Topics.SORA_BATCH_FAILED, self._handle_sora_batch_failed)
        self.event_bus.subscribe("blotato.publish.completed", self._handle_publish_completed)
        self.event_bus.subscribe("blotato.publish.failed", self._handle_publish_failed)
        self.event_bus.subscribe("twitter.campaign.scheduled", self._handle_twitter_scheduled)
        logger.info("📫 Orchestrator subscribed to subsystem events")

    async def start_pipeline(self, config: PipelineConfig) -> str:
        pipeline_id = f"pipeline-{uuid4().hex[:8]}"
        correlation_id = str(uuid4())
        logger.info(f"🚀 Starting pipeline {pipeline_id}: {config.theme}")
        
        # Create pipeline record in database
        try:
            pipeline_data = {
                "pipeline_id": pipeline_id,
                "theme": config.theme,
                "num_parts": config.num_parts,
                "character": config.character,
                "publish_platforms": config.publish_platforms,
                "schedule_tweets": config.schedule_tweets,
                "tweets_per_day": config.tweets_per_day,
                "offer_url": config.offer_url,
                "status": "initializing",
                "correlation_id": correlation_id,
                "metadata": config.metadata,
                "started_at": datetime.now(timezone.utc).isoformat()
            }
            result = self._insert_pipeline(pipeline_data)
            if not result.data:
                raise Exception("Failed to create pipeline record")
        except Exception as e:
            logger.error(f"❌ Failed to create pipeline record: {e}")
            raise

        # Track in memory
        self.active_pipelines[pipeline_id] = {
            "config": config,
            "correlation_id": correlation_id,
            "steps": self._create_pipeline_steps(config),
            "current_step": 0,
            "outputs": {}
        }

        # Emit pipeline started event
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_PIPELINE_STARTED,
            {"pipeline_id": pipeline_id, "theme": config.theme, "num_parts": config.num_parts},
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )

        # Start first step
        await self._execute_step_1_sora_generation(pipeline_id)
        return pipeline_id

    def _create_pipeline_steps(self, config: PipelineConfig) -> List[PipelineStep]:
        steps = [
            PipelineStep("sora_generation", 1),
            PipelineStep("content_analysis", 2),
            PipelineStep("multi_platform_publishing", 3),
        ]
        if config.schedule_tweets:
            steps.append(PipelineStep("twitter_campaign", 4))
        return steps

    async def _execute_step_1_sora_generation(self, pipeline_id: str) -> None:
        pipeline = self.active_pipelines[pipeline_id]
        config: PipelineConfig = pipeline["config"]
        correlation_id = pipeline["correlation_id"]
        step = pipeline["steps"][0]
        step.status = "running"
        step.started_at = datetime.now(timezone.utc)
        
        logger.info(f"[{pipeline_id}] Step 1: Sora video generation")
        await self._update_pipeline_status(pipeline_id, "generating_video")
        await self._update_step_status(pipeline_id, step)
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_STARTED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )
        
        # Request Sora batch generation (ARCH-002)
        await self.event_bus.publish(
            Topics.SORA_BATCH_REQUESTED,
            {
                "pipeline_id": pipeline_id,
                "theme": config.theme,
                "num_parts": config.num_parts,
                "character": config.character,
                "stitch": True,
                "remove_watermark": True
            },
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )

    async def _handle_sora_batch_completed(self, event: Event) -> None:
        payload = event.payload
        pipeline_id = payload.get("pipeline_id")
        if not pipeline_id or pipeline_id not in self.active_pipelines:
            return

        pipeline = self.active_pipelines[pipeline_id]
        step = pipeline["steps"][0]
        step.status = "completed"
        step.completed_at = datetime.now(timezone.utc)
        step.output = {
            "video_paths": payload.get("video_paths", []),
            "stitched_video": payload.get("stitched_video"),
            "analysis": payload.get("analysis")
        }
        pipeline["outputs"]["sora"] = step.output
        logger.info(f"[{pipeline_id}] ✅ Step 1 complete: Sora generation")
        
        await self._update_step_status(pipeline_id, step)
        await self._update_pipeline_data(pipeline_id, {
            "video_path": step.output.get("stitched_video"),
            "stitched_video": step.output.get("stitched_video"),
            "steps_completed": ["sora_generation"]
        })
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_COMPLETED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=pipeline["correlation_id"],
            source="MasterOrchestrator"
        )
        
        await self._execute_step_2_content_analysis(pipeline_id)

    async def _handle_sora_batch_failed(self, event: Event) -> None:
        payload = event.payload
        pipeline_id = payload.get("pipeline_id")
        if not pipeline_id or pipeline_id not in self.active_pipelines:
            return
        error = payload.get("error", "Unknown error")
        logger.error(f"[{pipeline_id}] ❌ Step 1 failed: {error}")
        await self._fail_pipeline(pipeline_id, "sora_generation", error)

    async def _execute_step_2_content_analysis(self, pipeline_id: str) -> None:
        pipeline = self.active_pipelines[pipeline_id]
        step = pipeline["steps"][1]
        correlation_id = pipeline["correlation_id"]
        step.status = "running"
        step.started_at = datetime.now(timezone.utc)
        
        logger.info(f"[{pipeline_id}] Step 2: Content analysis")
        await self._update_pipeline_status(pipeline_id, "analyzing")
        await self._update_step_status(pipeline_id, step)
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_STARTED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )
        
        try:
            sora_output = pipeline["outputs"].get("sora", {})
            sora_analysis = sora_output.get("analysis")
            
            if sora_analysis:
                analysis = sora_analysis
                logger.info(f"[{pipeline_id}] Using Sora's built-in analysis")
            else:
                video_path = sora_output.get("stitched_video")
                if not video_path:
                    raise Exception("No video available for analysis")
                transcript = "Video content placeholder transcript"
                analysis = self.content_analyzer.analyze_transcript(
                    transcript,
                    metadata={"theme": pipeline["config"].theme, "video_path": video_path}
                )
            
            step.status = "completed"
            step.completed_at = datetime.now(timezone.utc)
            step.output = {"analysis": analysis}
            pipeline["outputs"]["analysis"] = analysis
            
            logger.info(f"[{pipeline_id}] ✅ Step 2 complete: Analysis (viral_score={analysis.get('viral_score', 'N/A')})")
            
            await self._update_step_status(pipeline_id, step)
            await self._update_pipeline_data(pipeline_id, {
                "analysis_result": analysis,
                "steps_completed": ["sora_generation", "content_analysis"]
            })
            
            await self.event_bus.publish(
                Topics.ORCHESTRATOR_STEP_COMPLETED,
                {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
                correlation_id=correlation_id,
                source="MasterOrchestrator"
            )
            
            await self._execute_step_3_publishing(pipeline_id)
        except Exception as e:
            logger.error(f"[{pipeline_id}] ❌ Step 2 failed: {e}")
            await self._fail_pipeline(pipeline_id, "content_analysis", str(e))

    async def _execute_step_3_publishing(self, pipeline_id: str) -> None:
        pipeline = self.active_pipelines[pipeline_id]
        config: PipelineConfig = pipeline["config"]
        step = pipeline["steps"][2]
        correlation_id = pipeline["correlation_id"]
        step.status = "running"
        step.started_at = datetime.now(timezone.utc)
        
        logger.info(f"[{pipeline_id}] Step 3: Multi-platform publishing")
        await self._update_pipeline_status(pipeline_id, "publishing")
        await self._update_step_status(pipeline_id, step)
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_STARTED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )
        
        video_path = pipeline["outputs"]["sora"]["stitched_video"]
        analysis = pipeline["outputs"]["analysis"]
        caption = self._build_caption_from_analysis(analysis)
        pipeline["outputs"]["publish_jobs"] = []
        
        for platform in config.publish_platforms:
            await self.event_bus.publish(
                Topics.PUBLISH_REQUESTED,
                {
                    "pipeline_id": pipeline_id,
                    "platform": platform,
                    "video_path": video_path,
                    "caption": caption,
                    "analysis": analysis,
                    "hashtags": analysis.get("hashtags", []),
                    "offer_url": config.offer_url
                },
                correlation_id=correlation_id,
                source="MasterOrchestrator"
            )
            pipeline["outputs"]["publish_jobs"].append({"platform": platform, "status": "requested"})
        
        logger.info(f"[{pipeline_id}] 📤 Publishing to {len(config.publish_platforms)} platforms")

    async def _handle_publish_completed(self, event: Event) -> None:
        payload = event.payload
        pipeline_id = payload.get("pipeline_id")
        if not pipeline_id or pipeline_id not in self.active_pipelines:
            return

        pipeline = self.active_pipelines[pipeline_id]
        platform = payload.get("platform")
        
        for job in pipeline["outputs"].get("publish_jobs", []):
            if job["platform"] == platform:
                job["status"] = "completed"
                job["platform_url"] = payload.get("platform_url")
                break
        
        logger.info(f"[{pipeline_id}] ✅ Published to {platform}")
        
        all_complete = all(
            job["status"] in ["completed", "failed"]
            for job in pipeline["outputs"].get("publish_jobs", [])
        )
        
        if all_complete:
            step = pipeline["steps"][2]
            step.status = "completed"
            step.completed_at = datetime.now(timezone.utc)
            step.output = {"publish_jobs": pipeline["outputs"]["publish_jobs"]}
            
            logger.info(f"[{pipeline_id}] ✅ Step 3 complete: Multi-platform publishing")
            await self._update_step_status(pipeline_id, step)
            
            steps_completed = ["sora_generation", "content_analysis", "multi_platform_publishing"]
            await self._update_pipeline_data(pipeline_id, {"steps_completed": steps_completed})
            
            await self.event_bus.publish(
                Topics.ORCHESTRATOR_STEP_COMPLETED,
                {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
                correlation_id=pipeline["correlation_id"],
                source="MasterOrchestrator"
            )
            
            config: PipelineConfig = pipeline["config"]
            if config.schedule_tweets:
                await self._execute_step_4_twitter_campaign(pipeline_id)
            else:
                await self._complete_pipeline(pipeline_id)

    async def _handle_publish_failed(self, event: Event) -> None:
        payload = event.payload
        pipeline_id = payload.get("pipeline_id")
        if not pipeline_id or pipeline_id not in self.active_pipelines:
            return

        pipeline = self.active_pipelines[pipeline_id]
        platform = payload.get("platform")
        error = payload.get("error", "Unknown error")
        
        for job in pipeline["outputs"].get("publish_jobs", []):
            if job["platform"] == platform:
                job["status"] = "failed"
                job["error"] = error
                break
        
        logger.warning(f"[{pipeline_id}] ⚠️ Publish to {platform} failed: {error}")
        
        all_complete = all(
            job["status"] in ["completed", "failed"]
            for job in pipeline["outputs"].get("publish_jobs", [])
        )
        
        if all_complete:
            config: PipelineConfig = pipeline["config"]
            if config.schedule_tweets:
                await self._execute_step_4_twitter_campaign(pipeline_id)
            else:
                await self._complete_pipeline(pipeline_id)

    async def _execute_step_4_twitter_campaign(self, pipeline_id: str) -> None:
        pipeline = self.active_pipelines[pipeline_id]
        config: PipelineConfig = pipeline["config"]
        step = pipeline["steps"][3]
        correlation_id = pipeline["correlation_id"]
        step.status = "running"
        step.started_at = datetime.now(timezone.utc)
        
        logger.info(f"[{pipeline_id}] Step 4: Twitter campaign scheduling")
        await self._update_pipeline_status(pipeline_id, "scheduling_tweets")
        await self._update_step_status(pipeline_id, step)
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_STARTED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )
        
        interval_minutes = int((24 * 60) / config.tweets_per_day)
        
        await self.event_bus.publish(
            "twitter.campaign.schedule_requested",
            {
                "pipeline_id": pipeline_id,
                "theme": config.theme,
                "count": config.tweets_per_day,
                "interval_minutes": interval_minutes,
                "offer_url": config.offer_url
            },
            correlation_id=correlation_id,
            source="MasterOrchestrator"
        )
        
        logger.info(f"[{pipeline_id}] 🐦 Scheduling {config.tweets_per_day} tweets (interval={interval_minutes}min)")

    async def _handle_twitter_scheduled(self, event: Event) -> None:
        payload = event.payload
        pipeline_id = payload.get("pipeline_id")
        if not pipeline_id or pipeline_id not in self.active_pipelines:
            return

        pipeline = self.active_pipelines[pipeline_id]
        step = pipeline["steps"][3]
        step.status = "completed"
        step.completed_at = datetime.now(timezone.utc)
        step.output = {
            "tweets_scheduled": payload.get("tweets_scheduled", 0),
            "campaign_id": payload.get("campaign_id")
        }
        pipeline["outputs"]["twitter"] = step.output
        
        logger.info(f"[{pipeline_id}] ✅ Step 4 complete: {step.output['tweets_scheduled']} tweets scheduled")
        
        await self._update_step_status(pipeline_id, step)
        await self._update_pipeline_data(pipeline_id, {
            "tweets_scheduled": step.output["tweets_scheduled"],
            "steps_completed": ["sora_generation", "content_analysis", "multi_platform_publishing", "twitter_campaign"]
        })
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_STEP_COMPLETED,
            {"pipeline_id": pipeline_id, "step_name": step.name, "step_order": step.order},
            correlation_id=pipeline["correlation_id"],
            source="MasterOrchestrator"
        )
        
        await self._complete_pipeline(pipeline_id)

    def _build_caption_from_analysis(self, analysis: Dict[str, Any]) -> str:
        hook = analysis.get("detected_hook", "")
        topics = analysis.get("topics", [])
        caption_parts = []
        if hook:
            caption_parts.append(hook)
        if topics:
            caption_parts.append(" • ".join(topics[:3]))
        return "\n\n".join(caption_parts) if caption_parts else "Check out this video!"

    async def _complete_pipeline(self, pipeline_id: str) -> None:
        pipeline = self.active_pipelines[pipeline_id]
        logger.info(f"[{pipeline_id}] 🎉 Pipeline completed successfully")
        
        await self._update_pipeline_data(pipeline_id, {
            "status": "completed",
            "completed_at": datetime.now(timezone.utc).isoformat()
        })
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_PIPELINE_COMPLETED,
            {
                "pipeline_id": pipeline_id,
                "theme": pipeline["config"].theme,
                "outputs": {
                    "video_path": pipeline["outputs"]["sora"]["stitched_video"],
                    "published_count": len(pipeline["outputs"].get("publish_jobs", [])),
                    "tweets_scheduled": pipeline["outputs"].get("twitter", {}).get("tweets_scheduled", 0)
                }
            },
            correlation_id=pipeline["correlation_id"],
            source="MasterOrchestrator"
        )
        
        del self.active_pipelines[pipeline_id]

    async def _fail_pipeline(self, pipeline_id: str, error_step: str, error: str) -> None:
        if pipeline_id not in self.active_pipelines:
            return
        pipeline = self.active_pipelines[pipeline_id]
        logger.error(f"[{pipeline_id}] ❌ Pipeline failed at step {error_step}: {error}")
        
        await self._update_pipeline_data(pipeline_id, {
            "status": "failed",
            "error": error,
            "error_step": error_step,
            "failed_at": datetime.now(timezone.utc).isoformat()
        })
        
        await self.event_bus.publish(
            Topics.ORCHESTRATOR_PIPELINE_FAILED,
            {"pipeline_id": pipeline_id, "error_step": error_step, "error": error},
            correlation_id=pipeline["correlation_id"],
            source="MasterOrchestrator"
        )
        
        del self.active_pipelines[pipeline_id]

    async def _update_pipeline_status(self, pipeline_id: str, status: str) -> None:
        try:
            self._update_pipeline_status(pipeline_id, status)
        except Exception as e:
            logger.error(f"Failed to update pipeline status: {e}")

    async def _update_pipeline_data(self, pipeline_id: str, data: Dict[str, Any]) -> None:
        try:
            self._update_pipeline_data(pipeline_id, data)
        except Exception as e:
            logger.error(f"Failed to update pipeline data: {e}")

    async def _update_step_status(self, pipeline_id: str, step: PipelineStep) -> None:
        try:
            step_data = {
                "pipeline_id": pipeline_id,
                "step_name": step.name,
                "step_order": step.order,
                "status": step.status,
                "started_at": step.started_at.isoformat() if step.started_at else None,
                "completed_at": step.completed_at.isoformat() if step.completed_at else None,
                "output": step.output,
                "error": step.error
            }
            self._upsert_step(step_data)
        except Exception as e:
            logger.error(f"Failed to update step status: {e}")

    async def get_pipeline_status(self, pipeline_id: str) -> Dict[str, Any]:
        try:
            result = self._get_pipeline_summary(pipeline_id)
            if result.data and len(result.data) > 0:
                return result.data[0]
            return {"error": "Pipeline not found"}
        except Exception as e:
            logger.error(f"Failed to get pipeline status: {e}")
            return {"error": str(e)}

    async def list_pipelines(self, status: Optional[str] = None, limit: int = 10) -> List[Dict[str, Any]]:
        try:
            query = self._list_pipelines_query(limit)
            if status:
                query = query.eq("status", status)
            result = query.execute()
            return result.data or []
        except Exception as e:
            logger.error(f"Failed to list pipelines: {e}")
            return []
